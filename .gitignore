node_modules/
.env
.env.local
.env.production
# All env variants and backups (e.g. .env.pre-stripe-test.bak) — never commit secrets
.env.*
*.env
.env*.bak
# …except the placeholder template, which SHOULD ship with the repo
!.env.example
npm-debug.log
yarn-error.log
.DS_Store

# dev-only (local tools, not deployed)
src/routes/devRoutes.js
.env.bak

# scripts/ is dev-only BY DEFAULT, but the test-plan ops artifacts must ship:
# the daily vendor smoke, the nightly ledger reconciliation, the chaos drills
# and the E2E seeder are all referenced by package.json scripts, docs/cron and
# the Playwright harness. With the old blanket `/scripts/` rule they existed
# only on one laptop — a clone + the documented cron produced
# "Cannot find module". Note the trailing `*`: a blanket directory exclude
# cannot be undone by a negation, so the contents are excluded individually
# and the keepers re-included.
/scripts/*
!/scripts/smokeVendors.js
!/scripts/reconcileTrackerCredits.js
!/scripts/e2eSeed.js
!/scripts/chaos/
!/scripts/preflightImage.js
!/scripts/preflightDb.js

# Database backup archives (admin-triggered mongodump output)
/backups/
