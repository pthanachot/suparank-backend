# SupaRank backend (Express) — environment template.
# Copy to `.env` and fill in. NEVER commit real secrets. Values here are
# placeholders. Vars marked (required) must be set for the server to work;
# (dark) gate features that stay off until launch.

# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
# DB targeting. DB_NAME — not the URI path — selects the database (the dbName
# connect option overrides any path in the URI), so keep MONGODB_URI path-less.
# Set these in `.env` ONLY. A few tools (scripts/preflightImage.js,
# scripts/smokeVendors.js, tests/aiTracker/eval/*) load `.env.local` first and
# dotenv never overrides — a copy in `.env.local` silently shadows `.env`.
MONGODB_URI=mongodb://127.0.0.1:27017            # (required) Atlas URI in prod
DB_NAME=suparank
EXPECTED_DB_HOST=                                # substring of the connected host (boot warns + /health flags on mismatch). Atlas: the *.mongodb.net hash is per PROJECT — to tell same-project clusters apart use the per-cluster 'ac-<token>' prefix from the boot log
# (required) THE canonical app origin. Production value: https://suparank.ai
# Everything user-facing derives from this single var — email links, the email
# logo at /brand/suparank-mark.png, Stripe return URLs, the GSC OAuth redirect
# URI, the CORS allow-list, and the report-PDF render base. Note APP_URL in
# Railway is the BACKEND host and is read by nothing; do not point links at it.
# Changing this requires adding ${FRONTEND_URL}/api/gsc/callback to the Google
# Cloud authorised redirect URIs, or Search Console OAuth breaks.
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4001
PLATFORM_HOSTS=localhost:3000                     # comma-sep canonical platform hosts

# ─── Auth / JWT ────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-long-random         # (required) HS256 signing key
REFRESH_TOKEN_SECRET=change-me-different-random    # (required)
JWT_ISSUER=suparank
JWT_AUDIENCE=suparank-app
GSC_TOKEN_ENCRYPTION_KEY=change-me-32-byte-key     # encrypts stored GSC OAuth tokens
# Platform-admin allowlist (env-only). Up to 5 admins, one per slot; each slot
# is also comma-tolerant. ADMIN_EMAILS_2..5 are optional. This is the SOLE
# source of admin identity — there is no in-app "add admin" anymore.
ADMIN_EMAILS=you@example.com
ADMIN_EMAILS_2=
ADMIN_EMAILS_3=
ADMIN_EMAILS_4=
ADMIN_EMAILS_5=

# ─── Google OAuth (login + Search Console) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Writing engine (Go) — internal server-to-server ───────────────────────
ENGINE_URL=http://localhost:8080
WRITING_ENGINE_URL=http://localhost:8080
EXPRESS_INTERNAL_BASE_URL=http://localhost:4001
ENGINE_INTERNAL_KEY=change-me-shared-secret        # must match engine ENGINE_INTERNAL_KEY
INTERNAL_API_KEY=change-me-shared-secret           # engine→backend /api/internal auth
INTERNAL_API_KEY_PREVIOUS=                          # set during key rotation only
REWRITE_SECRET=change-me

# ─── Stripe (platform billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...                      # (required for billing)
STRIPE_WEBHOOK_SECRET=whsec_...                    # platform webhook endpoint secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...            # (dark) SaaS-mode Connect webhook — see project_stripe_webhook_setup
# Subscription price IDs
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_STANDARD_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_EXTRA_SEAT_MONTHLY_PRICE_ID=
STRIPE_PRO_EXTRA_SEAT_YEARLY_PRICE_ID=
STRIPE_AGENCY_MONTHLY_PRICE_ID=
STRIPE_AGENCY_YEARLY_PRICE_ID=
STRIPE_AGENCY_EXTRA_SEAT_MONTHLY_PRICE_ID=
STRIPE_AGENCY_EXTRA_SEAT_YEARLY_PRICE_ID=
# Wholesale credit top-up packs (SaaS mode)
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# ─── AI providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CHATGPT_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=

# ─── SEO / SERP data ───────────────────────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY=

# ─── Email (Brevo transactional + SMTP) ────────────────────────────────────
BREVO_API_KEY=                                     # (dark) white-label sender domains
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=

# ─── Object storage (Backblaze B2, S3-compatible) — image uploads ──────────
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_CDN_URL=

# ─── Cloudflare (custom tenant domains) — (dark) ───────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CF_FALLBACK_ORIGIN=

# ─── Feature switches ──────────────────────────────────────────────────────
IMPERSONATION_ENABLED=false                        # 'true' enables admin "log in as"
IMPERSONATION_TTL_MIN=30                            # impersonation token lifetime (1..240)

# ─── Reporting ─────────────────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=                          # Chromium path for PDF reports (Railway)
